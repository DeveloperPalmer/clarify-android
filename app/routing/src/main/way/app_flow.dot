digraph AppFlow {
  package = "ru.sla.clarify.app.routing"

  appFlow [
    type = "flow"
  ]

  loginFlow [
    type = "schema",
    resultType = "ru.sla.clarify.feature.login.routing.LoginFlow.Result"
  ]

  conversationFlow [
    type = "schema",
    resultType = "ru.sla.clarify.feature.chat.conversation.routing.ConversationFlow.Result"
  ]

  appFlow -> initialFlowResolve
  initialFlowResolve -> loginFlow
  initialFlowResolve -> conversationFlow
}
