import ru.sla.clarify.entity.chat.Conversation;
import ru.sla.clarify.entity.chat.Member;

CREATE TABLE ChatMember(
  id TEXT AS Member.Id NOT NULL,
  conversationId TEXT AS Conversation.Id NOT NULL,
  PRIMARY KEY (conversationId, id)
);

selectWithoutProfile:
SELECT DISTINCT
  ChatMember.id
FROM ChatMember
LEFT JOIN User
  ON User.id = ChatMember.id
WHERE User.id IS NULL AND ChatMember.id != :currentUserId;

selectIds:
SELECT
  id
FROM ChatMember
WHERE conversationId = :conversationId;

selectGroup:
SELECT
  ChatMember.id,
  User.displayName,
  User.email,
  User.photoUrl
FROM ChatMember
LEFT JOIN User
  ON User.id = ChatMember.id
WHERE ChatMember.conversationId = :conversationId;

selectDirect:
SELECT
  ChatMember.id,
  User.displayName,
  User.photoUrl
FROM ChatMember
LEFT JOIN User
  ON User.id = ChatMember.id
WHERE ChatMember.conversationId = :conversationId;

selectDirectById:
SELECT
  ChatMember.id,
  User.displayName,
  User.photoUrl
FROM ChatMember
LEFT JOIN User
  ON User.id = ChatMember.id
WHERE ChatMember.conversationId = :conversationId AND ChatMember.id = :id;

insertOrReplace:
INSERT OR REPLACE
INTO ChatMember(
  id,
  conversationId
)
VALUES (
  :id,
  :conversationId
);

delete:
DELETE FROM ChatMember
WHERE conversationId = ?;

deleteExcept:
DELETE FROM ChatMember
WHERE conversationId = :conversationId AND id NOT IN :memberIds;

deleteById:
DELETE FROM ChatMember
WHERE conversationId = :conversationId AND id = :id;

deleteAll:
DELETE FROM ChatMember;
