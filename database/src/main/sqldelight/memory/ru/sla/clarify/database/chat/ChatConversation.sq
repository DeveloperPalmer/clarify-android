CREATE TABLE ChatConversation(
  id TEXT PRIMARY KEY NOT NULL,
  peerId TEXT NOT NULL,
  lastCommit TEXT,
  lastCommitTimestamp INTEGER NOT NULL,
  unreadCount INTEGER NOT NULL
);

insertOrReplace:
INSERT OR REPLACE
INTO ChatConversation(id, peerId, lastCommit, lastCommitTimestamp, unreadCount)
VALUES (?, ?, ?, ?, ?);

insertIfAbsent:
INSERT OR IGNORE
INTO ChatConversation(id, peerId, lastCommit, lastCommitTimestamp, unreadCount)
VALUES (?, ?, ?, ?, ?);

selectAll:
SELECT
  ChatConversation.id,
  ChatConversation.peerId,
  ChatConversation.lastCommit,
  ChatConversation.lastCommitTimestamp,
  ChatConversation.unreadCount
FROM ChatConversation
ORDER BY ChatConversation.lastCommitTimestamp DESC;

selectById:
SELECT
  ChatConversation.id,
  ChatConversation.peerId,
  ChatConversation.lastCommit,
  ChatConversation.lastCommitTimestamp,
  ChatConversation.unreadCount
FROM ChatConversation
WHERE ChatConversation.id = :id;

delete:
DELETE FROM ChatConversation
WHERE id = ?;

deleteAll:
DELETE FROM ChatConversation;