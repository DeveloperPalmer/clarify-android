CREATE TABLE User (
  id TEXT NOT NULL PRIMARY KEY,
  email TEXT NOT NULL,
  displayName TEXT NOT NULL,
  photoUrl TEXT
);

insertOrReplace:
INSERT OR REPLACE
INTO User(id, email, displayName, photoUrl)
VALUES (?, ?, ?, ?);

selectById:
SELECT *
FROM User
WHERE id = ?
LIMIT 1;

deleteAll:
DELETE FROM User;
