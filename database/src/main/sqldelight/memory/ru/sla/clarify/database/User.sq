import ru.sla.clarify.core.domain.entity.UserId;

CREATE TABLE User(
  id TEXT AS UserId NOT NULL PRIMARY KEY,
  email TEXT NOT NULL,
  displayName TEXT NOT NULL,
  photoUrl TEXT
);

select:
SELECT *
FROM User
WHERE id = ?
LIMIT 1;

insertOrReplace:
INSERT OR REPLACE
INTO User(
  id,
  email,
  displayName,
  photoUrl
)
VALUES (
  :id,
  :email,
  :displayName,
  :photoUrl
);

deleteAll:
DELETE FROM User;
