import kotlin.Boolean;
import ru.sla.clarify.core.domain.entity.UserId;
import ru.sla.clarify.entity.chat.Branch;
import ru.sla.clarify.entity.chat.Commit;
import ru.sla.clarify.entity.chat.Conversation;

CREATE TABLE ChatCommit(
  id TEXT AS Commit.Id NOT NULL PRIMARY KEY,
  conversationId TEXT AS Conversation.Id NOT NULL,
  branchId TEXT AS Branch.Id NOT NULL,
  senderId TEXT AS UserId NOT NULL,
  type TEXT NOT NULL DEFAULT 'text',
  text TEXT NOT NULL,
  replyCommit TEXT AS Commit.Reply,
  invitedId TEXT AS UserId,
  createdAtNanos INTEGER NOT NULL,
  isSelf INTEGER AS Boolean NOT NULL,
  status TEXT NOT NULL,
  editedAtNanos INTEGER,
  FOREIGN KEY(conversationId) REFERENCES ChatConversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX ChatCommit_conversationId ON ChatCommit(conversationId);
CREATE INDEX ChatCommit_branchId ON ChatCommit(conversationId, branchId, createdAtNanos);

select:
SELECT
  id,
  senderId,
  type,
  text,
  replyCommit,
  invitedId,
  createdAtNanos,
  isSelf,
  status,
  editedAtNanos
FROM ChatCommit
WHERE conversationId = :conversationId AND branchId = :branchId
ORDER BY createdAtNanos DESC, id DESC;

selectByConversation:
SELECT
  id,
  branchId,
  senderId,
  type,
  text,
  replyCommit,
  invitedId,
  createdAtNanos,
  isSelf,
  status,
  editedAtNanos
FROM ChatCommit
WHERE conversationId = :conversationId AND createdAtNanos > 0
ORDER BY createdAtNanos ASC, id ASC;

selectOldestCursor:
SELECT
  id,
  createdAtNanos
FROM ChatCommit
WHERE conversationId = :conversationId AND branchId = :branchId AND createdAtNanos > 0
ORDER BY createdAtNanos ASC, id ASC
LIMIT 1;

selectEditState:
SELECT
  text,
  editedAtNanos,
  status
FROM ChatCommit
WHERE id = :id;

selectByIds:
SELECT *
FROM ChatCommit
WHERE id IN ?;

insertOrReplace:
INSERT OR REPLACE
INTO ChatCommit(
  id,
  conversationId,
  branchId,
  senderId,
  type,
  text,
  replyCommit,
  invitedId,
  createdAtNanos,
  isSelf,
  status,
  editedAtNanos
)
VALUES (
  :id,
  :conversationId,
  :branchId,
  :senderId,
  :type,
  :text,
  :replyCommit,
  :invitedId,
  :createdAtNanos,
  :isSelf,
  :status,
  :editedAtNanos
);

updateEdit:
UPDATE ChatCommit
SET
  text = :text,
  editedAtNanos = :editedAtNanos,
  status = :status
WHERE id = :id;

delete:
DELETE FROM ChatCommit
WHERE id = :id;

deleteAll:
DELETE FROM ChatCommit;
