import kotlin.Boolean;
CREATE TABLE ChatCommit(
  id TEXT NOT NULL PRIMARY KEY,
  conversationId TEXT NOT NULL,
  branchId TEXT NOT NULL,
  senderId TEXT NOT NULL,
  type TEXT NOT NULL DEFAULT 'text',
  text TEXT NOT NULL,
  invitedUid TEXT,
  createdAtNanos INTEGER NOT NULL,
  isSelf INTEGER AS Boolean NOT NULL,
  status TEXT NOT NULL,
  editedAtNanos INTEGER,
  FOREIGN KEY(conversationId) REFERENCES ChatConversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX ChatCommit_conversationId ON ChatCommit(conversationId);
CREATE INDEX ChatCommit_branchId ON ChatCommit(conversationId, branchId, createdAtNanos);

insertOrReplace:
INSERT OR REPLACE
INTO ChatCommit(id, conversationId, branchId, senderId, type, text, invitedUid, createdAtNanos, isSelf, status, editedAtNanos)
VALUES ?;

selectByBranchId:
SELECT
  id,
  senderId,
  type,
  text,
  invitedUid,
  createdAtNanos,
  isSelf,
  status,
  editedAtNanos
FROM ChatCommit
WHERE conversationId = :conversationId AND branchId = :branchId
ORDER BY createdAtNanos DESC, id DESC;

selectOldestCursor:
SELECT
  id,
  createdAtNanos
FROM ChatCommit
WHERE conversationId = :conversationId AND branchId = :branchId AND createdAtNanos > 0
ORDER BY createdAtNanos ASC, id ASC
LIMIT 1;

selectEditStateById:
SELECT text, editedAtNanos, status
FROM ChatCommit
WHERE id = :id;

updateEdit:
UPDATE ChatCommit
SET text = :text, editedAtNanos = :editedAtNanos, status = :status
WHERE id = :id;

deleteById:
DELETE FROM ChatCommit
WHERE id = :id;

deleteAll:
DELETE FROM ChatCommit;
