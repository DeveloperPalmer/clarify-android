import kotlin.Boolean;
import ru.sla.clarify.feature.chat.domain.entity.ChatMessage.Id;

CREATE TABLE ChatMessage(
  id TEXT AS Id PRIMARY KEY NOT NULL,
  parentId TEXT AS Id,
  conversationId TEXT NOT NULL,
  peerId TEXT NOT NULL,
  senderId TEXT NOT NULL,
  text TEXT NOT NULL,
  colorHex TEXT NOT NULL,
  timestamp INTEGER NOT NULL,
  isSelf INTEGER AS Boolean NOT NULL,
  status TEXT NOT NULL,
  FOREIGN KEY(conversationId) REFERENCES Conversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX ChatMessage_conversationId ON ChatMessage(conversationId);
CREATE INDEX ChatMessage_peerId ON ChatMessage(peerId);

insertOrReplace:
INSERT OR REPLACE
INTO ChatMessage(id, parentId, conversationId, peerId, senderId, text, colorHex, timestamp, isSelf, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT
  id,
  parentId,
  conversationId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE id = :id;

selectByPeer:
SELECT
  id,
  parentId,
  conversationId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
ORDER BY timestamp DESC
LIMIT :messageLimit;

selectByPeerBefore:
SELECT
  id,
  parentId,
  conversationId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
  AND timestamp < :timestamp
ORDER BY timestamp DESC
LIMIT :messageLimit;

selectChronologyByPeer:
SELECT
  id,
  parentId,
  conversationId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
ORDER BY timestamp ASC;

deleteByConversation:
DELETE FROM ChatMessage
WHERE conversationId = :conversationId;

deleteAll:
DELETE FROM ChatMessage;
