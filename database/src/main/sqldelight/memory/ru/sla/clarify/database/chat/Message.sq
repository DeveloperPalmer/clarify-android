import ru.sla.clarify.feature.chat.domain.entity.ChatMessage.Id;

CREATE TABLE ChatMessage(
  id TEXT AS Id PRIMARY KEY NOT NULL,
  parentId TEXT AS Id,
  peerId TEXT NOT NULL,
  senderId TEXT NOT NULL,
  text TEXT NOT NULL,
  colorHex TEXT,
  timestamp INTEGER NOT NULL,
  isSelf INTEGER NOT NULL,
  status TEXT NOT NULL,
  FOREIGN KEY(peerId) REFERENCES Peer(id) ON DELETE CASCADE ON UPDATE CASCADE
);

insertOrReplace:
INSERT OR REPLACE
INTO ChatMessage(id, parentId, peerId, senderId, text, colorHex, timestamp, isSelf, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT
  id,
  parentId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE id = :id;

selectByPeer:
SELECT
  id,
  parentId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
ORDER BY timestamp DESC
LIMIT :messageLimit;

selectByPeerBefore:
SELECT
  id,
  parentId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
  AND timestamp < :timestamp
ORDER BY timestamp DESC
LIMIT :messageLimit;

selectChronologyByPeer:
SELECT
  id,
  parentId,
  peerId,
  senderId,
  text,
  colorHex,
  timestamp,
  isSelf,
  status
FROM ChatMessage
WHERE peerId = :peerId
ORDER BY timestamp ASC;

deleteByPeer:
DELETE FROM ChatMessage
WHERE peerId = :peerId;

deleteAll:
DELETE FROM ChatMessage;
