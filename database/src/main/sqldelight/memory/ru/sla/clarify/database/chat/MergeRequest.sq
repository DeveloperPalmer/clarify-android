import kotlin.collections.Set;
import ru.sla.clarify.core.domain.entity.UserId;
import ru.sla.clarify.entity.chat.Branch;

CREATE TABLE MergeRequest(
  branchId TEXT AS Branch.Id NOT NULL PRIMARY KEY,
  status TEXT NOT NULL,
  initiatorId TEXT AS UserId NOT NULL,
  requestedAt INTEGER NOT NULL,
  approvedByIds TEXT AS Set<UserId> NOT NULL,
  mergedAt INTEGER,
  mergedIntoBranchId TEXT AS Branch.Id,
  FOREIGN KEY(branchId) REFERENCES ChatBranch(id) ON DELETE CASCADE ON UPDATE CASCADE
);

insertOrReplace:
INSERT OR REPLACE
INTO MergeRequest(
  branchId,
  status,
  initiatorId,
  requestedAt,
  approvedByIds,
  mergedAt,
  mergedIntoBranchId
)
VALUES (
  :branchId,
  :status,
  :initiatorId,
  :requestedAt,
  :approvedByIds,
  :mergedAt,
  :mergedIntoBranchId
);

delete:
DELETE FROM MergeRequest
WHERE branchId = ?;

deleteAll:
DELETE FROM MergeRequest;
