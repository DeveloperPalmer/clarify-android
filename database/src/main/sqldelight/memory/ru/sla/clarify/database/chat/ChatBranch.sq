import ru.sla.clarify.core.domain.entity.UserId;
import ru.sla.clarify.entity.chat.Branch;
import ru.sla.clarify.entity.chat.Commit;
import ru.sla.clarify.entity.chat.Conversation;

CREATE TABLE ChatBranch(
  id TEXT AS Branch.Id NOT NULL PRIMARY KEY,
  conversationId TEXT AS Conversation.Id NOT NULL,
  parentBranchId TEXT AS Branch.Id NOT NULL,
  branchedFromCommitId TEXT AS Commit.Id NOT NULL,
  name TEXT NOT NULL,
  lastCommit TEXT,
  lastCommitTimestamp INTEGER NOT NULL,
  unreadCount INTEGER NOT NULL DEFAULT 0,
  createdAt INTEGER NOT NULL,
  createdById TEXT AS UserId NOT NULL,
  FOREIGN KEY(conversationId) REFERENCES ChatConversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX ChatBranch_conversationId ON ChatBranch(conversationId);

selectIds:
SELECT
  id
FROM ChatBranch
WHERE conversationId = :conversationId;

selectByConversation:
SELECT
  ChatBranch.id,
  ChatBranch.conversationId,
  ChatBranch.parentBranchId,
  ChatBranch.branchedFromCommitId,
  ChatBranch.name,
  ChatBranch.lastCommit,
  ChatBranch.lastCommitTimestamp,
  ChatBranch.unreadCount,
  ChatBranch.createdAt,
  ChatBranch.createdById,
  MergeRequest.status AS mergeRequestStatus,
  MergeRequest.initiatorId AS mergeRequestInitiatorId,
  MergeRequest.requestedAt AS mergeRequestRequestedAt,
  MergeRequest.approvedByIds AS mergeRequestApprovedByIds,
  MergeRequest.mergedAt AS mergeRequestMergedAt,
  MergeRequest.mergedIntoBranchId AS mergeRequestMergedIntoBranchId
FROM ChatBranch
LEFT JOIN MergeRequest
  ON MergeRequest.branchId = ChatBranch.id
WHERE ChatBranch.conversationId = :conversationId
ORDER BY ChatBranch.createdAt ASC;

selectById:
SELECT
  ChatBranch.id,
  ChatBranch.conversationId,
  ChatBranch.parentBranchId,
  ChatBranch.branchedFromCommitId,
  ChatBranch.name,
  ChatBranch.lastCommit,
  ChatBranch.lastCommitTimestamp,
  ChatBranch.unreadCount,
  ChatBranch.createdAt,
  ChatBranch.createdById,
  MergeRequest.status AS mergeRequestStatus,
  MergeRequest.initiatorId AS mergeRequestInitiatorId,
  MergeRequest.requestedAt AS mergeRequestRequestedAt,
  MergeRequest.approvedByIds AS mergeRequestApprovedByIds,
  MergeRequest.mergedAt AS mergeRequestMergedAt,
  MergeRequest.mergedIntoBranchId AS mergeRequestMergedIntoBranchId
FROM ChatBranch
LEFT JOIN MergeRequest
  ON MergeRequest.branchId = ChatBranch.id
WHERE ChatBranch.id = :id;

insertOrReplace:
INSERT OR REPLACE
INTO ChatBranch(
  id,
  conversationId,
  parentBranchId,
  branchedFromCommitId,
  name,
  lastCommit,
  lastCommitTimestamp,
  unreadCount,
  createdAt,
  createdById
)
VALUES (
  :id,
  :conversationId,
  :parentBranchId,
  :branchedFromCommitId,
  :name,
  :lastCommit,
  :lastCommitTimestamp,
  COALESCE((SELECT unreadCount FROM ChatBranch WHERE id = :id), 0),
  :createdAt,
  :createdById
);

updateUnreadCount:
UPDATE ChatBranch
SET
  unreadCount = :unreadCount
WHERE id = :id;

delete:
DELETE FROM ChatBranch
WHERE id = ?;

deleteAll:
DELETE FROM ChatBranch;
