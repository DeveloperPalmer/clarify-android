CREATE TABLE Peer (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT,
  faceUrl TEXT
);

insertOrReplace:
INSERT OR REPLACE
INTO Peer(id, name, faceUrl)
VALUES (?, ?, ?);

insertIfAbsent:
INSERT OR IGNORE
INTO Peer(id, name, faceUrl)
VALUES (?, ?, ?);

select:
SELECT *
FROM Peer
WHERE id = ?;

delete:
DELETE FROM Peer;
