CREATE TABLE ChatConversationParticipant(
  conversationId TEXT NOT NULL,
  id TEXT NOT NULL,
  PRIMARY KEY (conversationId, id)
);

insertOrReplace:
INSERT OR REPLACE
INTO ChatConversationParticipant(conversationId, id)
VALUES (?, ?);

selectParticipantsWithoutProfile:
SELECT DISTINCT participant.id
FROM ChatConversationParticipant AS participant
LEFT JOIN User AS profile ON profile.id = participant.id
WHERE profile.id IS NULL AND participant.id != :currentUserId;

selectByConversation:
SELECT
  participant.id,
  profile.displayName,
  profile.photoUrl
FROM ChatConversationParticipant AS participant
LEFT JOIN User AS profile ON profile.id = participant.id
WHERE participant.conversationId = :conversationId;

selectByConversationWithEmail:
SELECT
  participant.id,
  profile.displayName,
  profile.email,
  profile.photoUrl
FROM ChatConversationParticipant AS participant
LEFT JOIN User AS profile ON profile.id = participant.id
WHERE participant.conversationId = :conversationId;

selectByConversationAndId:
SELECT
  participant.id,
  profile.displayName,
  profile.photoUrl
FROM ChatConversationParticipant AS participant
LEFT JOIN User AS profile ON profile.id = participant.id
WHERE participant.conversationId = :conversationId AND participant.id = :id;

deleteByConversation:
DELETE FROM ChatConversationParticipant
WHERE conversationId = ?;

deleteByConversationAndId:
DELETE FROM ChatConversationParticipant
WHERE conversationId = :conversationId AND id = :id;

deleteAll:
DELETE FROM ChatConversationParticipant;
