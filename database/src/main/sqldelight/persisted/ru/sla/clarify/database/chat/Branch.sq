CREATE TABLE Branch(
  id TEXT NOT NULL PRIMARY KEY,
  conversationId TEXT NOT NULL,
  parentBranchId TEXT NOT NULL,
  branchedFromCommitId TEXT NOT NULL,
  name TEXT NOT NULL,
  lastCommit TEXT,
  lastCommitTimestamp INTEGER NOT NULL,
  unreadCount INTEGER NOT NULL DEFAULT 0,
  createdAt INTEGER NOT NULL,
  createdByUid TEXT NOT NULL,
  FOREIGN KEY(conversationId) REFERENCES ChatConversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX Branch_conversationId ON Branch(conversationId);

insertOrReplace:
INSERT OR REPLACE
INTO Branch(
  id,
  conversationId,
  parentBranchId,
  branchedFromCommitId,
  name,
  lastCommit,
  lastCommitTimestamp,
  unreadCount,
  createdAt,
  createdByUid
)
VALUES (
  :id,
  :conversationId,
  :parentBranchId,
  :branchedFromCommitId,
  :name,
  :lastCommit,
  :lastCommitTimestamp,
  COALESCE((SELECT unreadCount FROM Branch WHERE id = :id), 0),
  :createdAt,
  :createdByUid
);

updateUnreadCount:
UPDATE Branch
SET unreadCount = :unreadCount
WHERE id = :id;

selectIdsByConversationId:
SELECT id
FROM Branch
WHERE conversationId = :conversationId;

selectByConversationId:
SELECT
  b.id,
  b.conversationId,
  b.parentBranchId,
  b.branchedFromCommitId,
  b.name,
  b.lastCommit,
  b.lastCommitTimestamp,
  b.unreadCount,
  b.createdAt,
  b.createdByUid,
  mr.status AS mergeRequestStatus,
  mr.initiatorUid AS mergeRequestInitiatorUid,
  mr.requestedAt AS mergeRequestRequestedAt,
  mr.approvedByUids AS mergeRequestApprovedByUids,
  mr.mergedAt AS mergeRequestMergedAt,
  mr.mergedIntoBranchId AS mergeRequestMergedIntoBranchId
FROM Branch b
LEFT JOIN MergeRequest mr ON mr.branchId = b.id
WHERE b.conversationId = :conversationId
ORDER BY b.createdAt ASC;

selectById:
SELECT
  b.id,
  b.conversationId,
  b.parentBranchId,
  b.branchedFromCommitId,
  b.name,
  b.lastCommit,
  b.lastCommitTimestamp,
  b.unreadCount,
  b.createdAt,
  b.createdByUid,
  mr.status AS mergeRequestStatus,
  mr.initiatorUid AS mergeRequestInitiatorUid,
  mr.requestedAt AS mergeRequestRequestedAt,
  mr.approvedByUids AS mergeRequestApprovedByUids,
  mr.mergedAt AS mergeRequestMergedAt,
  mr.mergedIntoBranchId AS mergeRequestMergedIntoBranchId
FROM Branch b
LEFT JOIN MergeRequest mr ON mr.branchId = b.id
WHERE b.id = :id;

deleteById:
DELETE FROM Branch
WHERE id = ?;

deleteAll:
DELETE FROM Branch;
