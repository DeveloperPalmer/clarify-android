import kotlin.Boolean;
CREATE TABLE ChatCommit(
  id TEXT NOT NULL PRIMARY KEY,
  conversationId TEXT NOT NULL,
  branchId TEXT NOT NULL,
  senderId TEXT NOT NULL,
  type TEXT NOT NULL DEFAULT 'text',
  text TEXT NOT NULL,
  invitedUid TEXT,
  timestamp INTEGER NOT NULL,
  isSelf INTEGER AS Boolean NOT NULL,
  status TEXT NOT NULL,
  FOREIGN KEY(conversationId) REFERENCES ChatConversation(id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE INDEX ChatCommit_conversationId ON ChatCommit(conversationId);
CREATE INDEX ChatCommit_branchId ON ChatCommit(conversationId, branchId);

insertOrReplace:
INSERT OR REPLACE
INTO ChatCommit(id, conversationId, branchId, senderId, type, text, invitedUid, timestamp, isSelf, status)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT
  id,
  senderId,
  type,
  text,
  invitedUid,
  timestamp,
  isSelf,
  status
FROM ChatCommit
WHERE id = :id;

selectByBranchId:
SELECT
  id,
  senderId,
  type,
  text,
  invitedUid,
  timestamp,
  isSelf,
  status
FROM ChatCommit
WHERE conversationId = :conversationId AND branchId = :branchId
ORDER BY timestamp ASC;

deleteById:
DELETE FROM ChatCommit
WHERE id = :id;

deleteAll:
DELETE FROM ChatCommit;
