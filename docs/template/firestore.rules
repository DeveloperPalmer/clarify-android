rules_version = '2';

// ВНИМАНИЕ: референсные правила под модель chat (direct + group). В репозитории
// рабочих правил не было — это черновик под проект clarify-ba6ae. ОБЯЗАТЕЛЬНО
// сверьте с тем, что уже задеплоено в Firebase Console, прежде чем публиковать:
// здесь воспроизведена ВСЯ модель (включая direct/branches), а не только дельта
// под группы. Если рабочие правила строже — переносите точечно (см. чат: список
// новых требований под группы — изменение participantUids, удаление participant/
// unread-доков, чтение подколлекции participants).
//
// Модель доверия повторяет существующую логику клиента: операции на уровне
// conversation разрешены ЛЮБОМУ участнику (direct уже так работает — отправитель
// создаёт participant-доки и инкрементит чужой unreadCommits). Ограничения
// «только владелец» (rename / удаление участника / удаление группы) сейчас
// держатся на UI; в правилах ниже владелец-only вынесен лишь на delete группы.
// Если нужно ужесточить до field-level/owner-level — это НОВАЯ политика, выходящая
// за рамки текущего direct-поведения (см. P1-заметку в чате).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ---- users -------------------------------------------------------------
    // read открыт всем аутентифицированным: нужен для prefix-поиска по email
    // (инвайт) и для резолва профилей чужих участников (subscribeOnParticipantProfiles).
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId;
      allow delete: if false;
    }

    // ---- conversations -----------------------------------------------------
    match /conversations/{conversationId} {

      // participantUids ДО операции (для read/update/delete существующего документа).
      function members() {
        return resource.data.participantUids;
      }

      // participantUids ПОСЛЕ операции — для документов, создаваемых в том же
      // batch, что и сам conversation (ленивое создание direct'а; группа уже
      // существует к моменту отправки/инвайта, но getAfter корректен и тогда).
      function membersAfter() {
        return getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
      }

      allow read: if signedIn() && uid() in members();

      // create:
      //  - direct: создатель присутствует в participantUids;
      //  - group : дополнительно ownerUid == создатель и type == 'group'.
      allow create: if signedIn()
        && uid() in request.resource.data.participantUids
        && (
          request.resource.data.type != 'group'
          || request.resource.data.ownerUid == uid()
        );

      // update: любой текущий участник. Покрывает merge lastCommit при отправке,
      // переименование (owner — на UI), arrayUnion при инвайте, arrayRemove при
      // выходе/удалении участника.
      allow update: if signedIn() && uid() in members();

      // delete: direct — любой участник (существующее поведение deleteConversations);
      //         group — только владелец.
      allow delete: if signedIn()
        && uid() in members()
        && (resource.data.type != 'group' || resource.data.ownerUid == uid());

      // ---- participants ----------------------------------------------------
      function parentMembers() {
        return get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
      }
      function parentMembersAfter() {
        return getAfter(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.participantUids;
      }

      match /participants/{participantId} {
        // read — для participantsLive (состав группы).
        allow read: if signedIn() && uid() in parentMembers();
        // create — создатель direct'а заводит доки обоих участников; владелец
        // группы заводит док приглашённого (в том же batch с arrayUnion → After).
        allow create: if signedIn() && uid() in parentMembersAfter();
        // delete — выход из группы (self) и удаление участника владельцем.
        allow delete: if signedIn() && uid() in parentMembers();
        allow update: if false;
      }

      // ---- commits ---------------------------------------------------------
      match /commits/{commitId} {
        allow read: if signedIn() && uid() in parentMembers();
        // create — только сам отправитель; conversation мог быть создан тем же
        // batch'ем (direct lazy) → membersAfter. Покрывает и системный
        // inviteParticipant-commit (senderUid == текущий пользователь).
        allow create: if signedIn()
          && request.resource.data.senderUid == uid()
          && uid() in parentMembersAfter();
        allow update, delete: if false;
      }

      // ---- unreadCommits/{uid} --------------------------------------------
      // Документ счётчика непрочитанного конкретного пользователя.
      match /unreadCommits/{counterUserId} {
        // read — только свой счётчик (unreadCountLive).
        allow read: if signedIn() && uid() == counterUserId;
        // write — любой участник: инкремент чужого unread при отправке, очистка
        // своего при прочтении, удаление при выходе/удалении участника.
        allow write: if signedIn()
          && (uid() in parentMembers() || uid() in parentMembersAfter());
      }

      // ---- branches (существующая фича Clarify) ----------------------------
      match /branches/{branchId} {
        allow read, write: if signedIn() && uid() in parentMembers();
      }
    }
  }
}
