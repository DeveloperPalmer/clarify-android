digraph ThreadFlow {
  package = "ru.sla.clarify.feature.chat.thread.routing"

  threadFlow [
    type = "flow"
    parameterName = "id"
    parameterType = "ru.sla.clarify.feature.entity.chat.Peer.Id"
  ]

  branch [
    parameterName = "id",
    parameterType = "ru.sla.clarify.feature.chat.thread.domain.entity.Branch.Id"
  ]

  threadFlow -> thread -> branch
}
