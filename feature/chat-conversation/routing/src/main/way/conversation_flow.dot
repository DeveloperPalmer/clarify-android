digraph ConversationFlow {
  package = "ru.sla.clarify.feature.chat.conversation.routing"

  conversationFlow [
    type = "flow",
    resultType = "ru.sla.clarify.feature.chat.conversation.routing.ConversationFlow.Result"
  ]

  threadFlow [
    type = "schema"
    parameterName = "target"
    parameterType = "ru.sla.clarify.feature.chat.direct.thread.domain.entity.ThreadTarget"
  ]

  groupThreadFlow [
    type = "schema"
    parameterName = "conversationId"
    parameterType = "ru.sla.clarify.feature.chat.conversation.domain.entity.Conversation.Id"
    resultType = "ru.sla.clarify.feature.chat.group.thread.routing.GroupThreadFlow.Result"
  ]

  profileFlow [
    type = "schema",
    resultType = "ru.sla.clarify.feature.profile.routing.ProfileFlow.Result"
  ]

  conversationFlow -> main

  main -> threadFlow
  main -> groupThreadFlow
  main -> profileFlow
}
