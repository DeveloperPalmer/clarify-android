digraph DirectThreadFlow {
  package = "ru.sla.clarify.feature.chat.direct.thread.routing"

  directThreadFlow [
    type = "flow"
    parameterName = "params"
    parameterType = "ru.sla.clarify.feature.chat.direct.thread.domain.entity.TargetParams"
  ]

  branchFlow [
    type = "schema"
    parameterName = "params"
    parameterType = "ru.sla.clarify.feature.chat.branch.domain.entity.TargetParams"
  ]

  chronologyFlow [
    type = "schema"
    parameterName = "params"
    parameterType = "ru.sla.clarify.feature.chronology.domain.entity.TargetParams"
  ]

  directThreadFlow -> directThread
  directThread -> branchFlow
  directThread -> chronologyFlow
}
