digraph ThreadFlow {
  package = "ru.sla.clarify.feature.chat.direct.thread.routing"

  threadFlow [
    type = "flow"
    parameterName = "target"
    parameterType = "ru.sla.clarify.feature.chat.direct.thread.domain.entity.ThreadTarget"
  ]

  branchFlow [
    type = "schema"
    parameterName = "id"
    parameterType = "ru.sla.clarify.feature.chat.branch.domain.entity.Branch.Id"
  ]

  threadFlow -> thread -> branchFlow
}
